# Copy this file to .env and replace the placeholder secrets:
#   cp .env.example .env
# .env is ignored by git and by Docker builds. Never commit real values.

# --- PostgreSQL (read by the db service AND by the backend) -----------------
POSTGRES_DB=raisehand
POSTGRES_USER=raisehand
POSTGRES_PASSWORD=change-me-strong-password

# --- Django ------------------------------------------------------------------
# Generate a key (at least 32 characters — it also signs the JWT tokens):
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-of-50-characters
DJANGO_DEBUG=0
# Hosts the app may be served on. A leading dot allows all subdomains, so
# .trycloudflare.com covers the tunnel. For the same-Wi-Fi demo add your LAN IP
# (e.g. ...,192.168.1.5); * allows any host.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com

# --- Application -------------------------------------------------------------
APP_NAME=Raise Hand
# Address other devices use to reach the FRONTEND; it goes into the QR code.
#   empty (recommended): the tunnel address when `docker compose --profile tunnel up -d`
#                        is running, otherwise FRONTEND_URL
#   same Wi-Fi without tunnel: http://<your LAN IP>:3000
PUBLIC_URL=
# Where the browser finds the React frontend (the `frontend` service). The API puts it
# into the links it hands out (QR code, projector page) when PUBLIC_URL and the tunnel are off.
FRONTEND_URL=http://localhost:3000
# Origins allowed to call the API directly across origins (CORS). Not needed through the
# nginx proxy of the frontend service; needed for `npm run dev` with VITE_API_URL set.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# How often the pages poll for new questions, in seconds
REFRESH_SECONDS=3
# 1 = load demo data on start (40 student accounts, 10 lectures with material and topics,
# 120+ questions, answers, upvotes); safe to leave on, the seeding is idempotent.
# 0 = start with the demo accounts and one lecture only.
SEED_DEMO=1
# Password of the demo accounts (admin, lecturer, student, student01..40). Change it before a public demo.
DEMO_PASSWORD=Demo12345!

# --- JWT ---------------------------------------------------------------------
# Access tokens are short-lived and sent with every request; refresh tokens are
# exchanged for a new pair at /api/auth/refresh/ (rotated and revoked on use).
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Automatic topic tagging (qa/tagging.py) ---------------------------------
# tfidf = char n-gram TF-IDF + keyword bonus (default); keywords = keyword rule only
TAGGING_BACKEND=tfidf
# Below this score a new question stays untagged (0..1); raise it for fewer, surer tags
TAGGING_THRESHOLD=0.18
# Cosine similarity above which an existing question is shown as "already asked"
SIMILAR_THRESHOLD=0.35

# --- Docker Compose ----------------------------------------------------------
# Host port of the React frontend (nginx) — open http://localhost:3000
FRONTEND_PORT=3000
# Host port that maps to port 8000 inside the web (API) container — Swagger at http://localhost:8000/docs/
WEB_PORT=8000
# Host port (localhost only) that maps to PostgreSQL, for psql / DataGrip
DB_PORT_HOST=5433
