# Copy this file to .env and replace the placeholder secrets:
#   cp .env.example .env
# .env is ignored by git and by Docker builds. Never commit real values.

# --- PostgreSQL (read by the db service AND by the backend) -----------------
POSTGRES_DB=raisehand
POSTGRES_USER=raisehand
POSTGRES_PASSWORD=change-me-strong-password

# --- Django ------------------------------------------------------------------
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_DEBUG=0
# Hosts the app may be served on. A leading dot allows all subdomains, so
# .trycloudflare.com covers the tunnel. For the same-Wi-Fi demo add your LAN IP
# (e.g. ...,192.168.1.5); * allows any host.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com

# --- Application -------------------------------------------------------------
APP_NAME=Raise Hand
# Address other devices use to reach this machine; it goes into the QR code.
#   empty (recommended): the tunnel address when `docker compose --profile tunnel up -d`
#                        is running, otherwise the address the screen page was opened with
#   same Wi-Fi without tunnel: http://<your LAN IP>:8000
PUBLIC_URL=
# How often the pages poll for new questions, in seconds
REFRESH_SECONDS=3
# 1 = load demo data on start (8 lectures, 100+ questions, upvotes); safe to leave on,
# the seeding is idempotent. 0 = start with the single demo lecture only.
SEED_DEMO=1

# --- Docker Compose ----------------------------------------------------------
# Host port that maps to port 8000 inside the web container
WEB_PORT=8000
# Host port (localhost only) that maps to PostgreSQL, for psql / DataGrip
DB_PORT_HOST=5433
