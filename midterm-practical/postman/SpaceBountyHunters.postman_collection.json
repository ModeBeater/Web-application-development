              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "description": "Body from the assignment. `created_at` sent by the client is ignored - the server sets it. The new id is saved into `hunt_id`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\",\n  \"created_at\": \"2000-01-01T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"created_at comes from the server, not from the client\", () => pm.expect(body.created_at).to.not.include(\"2000-01-01\"));",
                  "pm.test(\"Server assigned id and created_at\", () => { pm.expect(body.id).to.be.a(\"number\"); pm.expect(body.created_at).to.be.a(\"string\"); pm.expect(body.criminal_id).to.eql(3); pm.expect(body.success).to.eql(false); });",
                  "pm.collectionVariables.set(\"hunt_id\", body.id);"
                ]
              }
            }
