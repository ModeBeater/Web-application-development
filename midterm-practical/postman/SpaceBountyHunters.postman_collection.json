                "api",
                "criminals",
                ""
              ]
            },
            "description": "All wanted criminals, ordered by id."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns a list with at least 5 criminals\", () => { pm.expect(body).to.be.an(\"array\"); pm.expect(body.length).to.be.at.least(5); });",
                  "pm.test(\"Each criminal has the required fields\", () => { for (const c of body) { pm.expect(c).to.have.all.keys(\"id\",\"name\",\"nickname\",\"reward\",\"last_known_coordinates\",\"location_note\",\"difficulty\",\"armed\",\"has_crew\",\"escape_master\",\"hunt_count\"); } });"
                ]
              }
            }
          ]
        },
        {
          "name": "Example from the task: ?min_reward=5000&armed=true&sort=-reward",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/criminals/?min_reward=5000&armed=true&sort=-reward",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "armed",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "-reward"
                }
              ]
            },
            "description": "The exact example from the assignment text."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Only armed criminals with reward >= 5000, most expensive first\", () => { pm.expect(body.length).to.be.above(0); for (const c of body) { pm.expect(c.armed).to.eql(true); pm.expect(Number(c.reward)).to.be.at.least(5000); } for (let i = 1; i < body.length; i++) pm.expect(Number(body[i-1].reward)).to.be.at.least(Number(body[i].reward)); });"
                ]
              }
            }
          ]
        },
