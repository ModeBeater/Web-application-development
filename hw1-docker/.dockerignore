# Keep the build context small and keep secrets/junk out of the image

# Version control
.git
.gitignore

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local data and secrets (pass configuration with -e / --env-file instead)
db.sqlite3
.env
.env.*

# Docker and docs are not needed inside the image
Dockerfile
.dockerignore
README.md

# IDE / OS files
.idea/
.vscode/
.DS_Store
